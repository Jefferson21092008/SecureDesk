FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx gettext-base \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY app ./app
COPY scripts ./scripts
COPY alembic.ini .
COPY alembic ./alembic
COPY frontend/index.html /usr/share/nginx/html/index.html
COPY frontend/styles.css /usr/share/nginx/html/styles.css
COPY frontend/app.js /usr/share/nginx/html/app.js
COPY docker/nginx.production.conf.template /etc/nginx/templates/securedesk.conf.template
COPY docker/start-production.sh /app/docker/start-production.sh

RUN pip install --no-cache-dir . \
    && chmod +x /app/docker/start-production.sh \
    && rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf

CMD ["/app/docker/start-production.sh"]
