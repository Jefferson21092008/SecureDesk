APP_NAME=SecureDesk
APP_ENV=development
DEBUG=false

POSTGRES_DB=securedesk
POSTGRES_USER=securedesk
POSTGRES_PASSWORD=securedesk

# Development-only example. Generate a different high-entropy secret for production.
JWT_SECRET=development-only-secret-change-me-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=securedesk
JWT_AUDIENCE=securedesk-api
ACCESS_TOKEN_MINUTES=30

# Rate limiting / anti-abuse
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=20
REGISTER_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=300
ATTACHMENT_MAX_BYTES=5242880

# Use this URL only when running the API directly on the host.
DATABASE_URL=postgresql+psycopg://securedesk:securedesk@localhost:5432/securedesk

# When running the API directly on the host, uploaded files are stored here by default.
ATTACHMENTS_DIR=uploads/attachments
